# RootCause AI: API + investigator + built dashboard in one image.
FROM node:20-alpine AS dashboard
WORKDIR /dash
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt "setuptools<81"
COPY rootcause ./rootcause
COPY --from=dashboard /dash/dist ./dashboard/dist
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "-m", "rootcause", "serve", "--port", "8000"]
